{
  "name": "@agentmatrix/agentcanvas-react",
  "version": "0.2.0",
  "description": "Controlled React 19 AgentCanvas Experience configurator and preview.",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.css.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs react && tsc -p tsconfig.json && node ../../scripts/copy-package-assets.mjs react"
  },
  "dependencies": {
    "@agentmatrix/agentcanvas-contract": "0.2.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0"
}
