{
  "name": "agentcanvas",
  "private": true,
  "version": "0.2.0",
  "description": "Visual UX configurator and scaffold generator for Agent frontends: configure how reasoning, tool calls, approvals, artifacts and timelines are presented, preview it live, then export a runnable React project.",
  "license": "MIT",
  "author": "Raytone-Lab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raytone-lab/agentcanvas.git"
  },
  "homepage": "https://github.com/raytone-lab/agentcanvas#readme",
  "bugs": {
    "url": "https://github.com/raytone-lab/agentcanvas/issues"
  },
  "keywords": [
    "agent",
    "agent-ux",
    "llm",
    "react",
    "scaffold",
    "configurator",
    "generative-ui"
  ],
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run packages:build && vite",
    "build": "npm run packages:build && tsc && vite build",
    "packages:build": "npm run build --workspace @agentmatrix/agentcanvas-contract && npm run build --workspace @agentmatrix/agentcanvas-react",
    "packages:pack": "node scripts/pack-packages.mjs",
    "packages:verify": "npm run packages:build && vitest run packages && node scripts/verify-platform-schema.mjs && node scripts/verify-node-ssr.mjs && node scripts/verify-clean-package-build.mjs && node scripts/verify-clean-consumer.mjs",
    "preview": "vite preview",
    "test": "npm run packages:build && vitest run",
    "typecheck": "npm run packages:build && tsc --noEmit",
    "test:export-smoke": "npm run packages:build && RUN_SCAFFOLD_SMOKE=1 vitest run src/export/scaffoldSmoke.test.ts",
    "video:studio": "remotion studio",
    "video:render": "remotion render AgentCanvasProductIntro out/agentcanvas-product-intro.mp4",
    "video:still": "remotion still AgentCanvasProductIntro out/agentcanvas-product-intro.png --frame=150"
  },
  "dependencies": {
    "@agent-ux/protocol": "file:vendor/agent-ux/protocol",
    "@agent-ux/react": "file:vendor/agent-ux/react",
    "@agent-ux/render-core": "file:vendor/agent-ux/render-core",
    "@agent-ux/runtime": "file:vendor/agent-ux/runtime",
    "@gsap/react": "^2.1.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-popover": "^1.1.16",
    "@radix-ui/react-slider": "^1.4.0",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.8",
    "cmdk": "^1.1.1",
    "generative-loaders": "^0.1.1",
    "gsap": "^3.15.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-resizable-panels": "^4.11.1",
    "sonner": "^2.0.7",
    "thinking-orbs": "^0.1.1"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.466",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "ajv": "^8.20.0",
    "jsdom": "^27.4.0",
    "remotion": "^4.0.466",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
